# Acıbadem Backend Environment Variables
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun

# Application
NODE_ENV=production
PORT=5000
GATEWAY_PORT=3000

# Database - GERÇEK connection string kullanın! Placeholder KALDIRIN.
# Örnek: mongodb://user:pass@localhost:27017/acibadem
# Atlas: mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/acibadem?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/acibadem
MONGO_CA_CERT=/path/to/ca-cert.pem

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-here-minimum-32-characters
JWT_EXPIRES_IN=1h

# External Services (ZORUNLU - Production için)
MOBILIZ_BASE_URL=https://ng.mobiliz.com.tr/su5/api/integrations
MOBILIZ_TOKEN=your-mobiliz-token-here

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=false
MAIL_FROM_NAME=Acıbadem Portal
MAIL_FROM_EMAIL=noreply@acibadem.com.tr

# Frontend URL - Mail linkleri, şifre sıfırlama vb. için
# IP: http://192.168.0.46  |  Domain: https://ulasimtransfer.acibadem.com.tr
FRONTEND_BASE_URL=http://192.168.0.46

# CORS / Socket.IO - Frontend origin'leri (virgülle ayrılmış)
# Backend bu origin'lerden gelen isteklere izin verir
ALLOWED_ORIGINS=http://192.168.0.46,http://192.168.0.46:3000,https://ulasimtransfer.acibadem.com.tr

# Service Communication (for microservices)
SERVICE_SECRET=your-service-to-service-secret-key

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ⚡ Redis Cache (OPSİYONEL - Performans için önerilir)
# REDIS_URL=redis://localhost:6379
# veya ayrı parametreler:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=