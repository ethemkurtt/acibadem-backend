# Acıbadem Backend - Production .env
# Sunucuya yükleyip .env olarak kopyalayın: cp env.backend.production .env
# JWT_SECRET, SMTP_PASS, SERVICE_SECRET boşsa doldurun!

# Application
NODE_ENV=production
PORT=5000
GATEWAY_PORT=3000

# Database - 10.6.243.94 (auth varsa: mongodb://user:pass@10.6.243.94:27017/acibadem)
MONGO_URI=mongodb://10.6.243.94:27017/acibadem

# JWT - Güçlü secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-here-minimum-32-characters
JWT_EXPIRES_IN=24h

# Mobiliz
MOBILIZ_BASE_URL=https://ng.mobiliz.com.tr/su5/api/integrations
MOBILIZ_TOKEN=your-mobiliz-token-here

# Email - Gönderen: noreply@acibadem.com.tr
# SMTP relay (port 25, auth yok) veya SMTP (port 587)
SMTP_HOST=mail.acibadem.com.tr
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM_NAME=Acıbadem Portal
MAIL_FROM_EMAIL=noreply@acibadem.com.tr

# Frontend (192.168.0.46) - Backend buna mail linki, CORS izni verir
FRONTEND_BASE_URL=http://192.168.0.46

# CORS / Socket.IO - Frontend origin'leri
ALLOWED_ORIGINS=http://192.168.0.46,http://192.168.0.46:80,http://192.168.0.46:3000,https://ulasimtransfer.acibadem.com.tr

# Service Communication
SERVICE_SECRET=your-service-to-service-secret-key

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
